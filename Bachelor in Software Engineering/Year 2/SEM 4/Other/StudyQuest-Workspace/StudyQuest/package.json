{
  "name": "studyquest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StudyQuest — adventure web-game finals engine for Mohammed's 5 subjects",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "convert": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/convert-pptx.ps1",
    "calibrate": "node scripts/calibrate-plan.js",
    "validate-banks": "node scripts/validate-banks.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-pdf": "^9.2.1",
    "react-router-dom": "^6.30.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "vite": "^6.2.0"
  }
}
