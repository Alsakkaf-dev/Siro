          <GuiSettings Plugin="AlteryxGuiToolkit.TextBox.TextBox">
            <Position x="126" y="618" width="324" height="60" />
          </GuiSettings>
          <Properties>
            <Configuration>
              <Text>Configure a Formula tool to produce the following output. 
If a subscription is $7.99 a month, calculate how much each customer paid. If they cancel before the first month is over they are not charged. 

Hint: One of the DateTime functions calculates the number of months in this exact manner. Use that function to calculate the number of months that passed between the subscription and cancelation dates as your first step.</Text>
              <Font name="Arial" size="9" style="0" />
              <TextColor name="Black" />
              <FillColor name="White" />
              <Shape shape="0" />
              <Justification Justification="3" />
            </Configuration>
            <Annotation DisplayMode="0">
              <Name />
              <DefaultAnnotationText />
              <Left value="False" />
            </Annotation>
          </Properties>
        </Node>
        <Node ToolID="223">
          <GuiSettings Plugin="AlteryxBasePluginsGui.TextInput.TextInput">
            <Position x="102" y="726" />
          </GuiSettings>
          <Properties>
            <Configuration>
              <NumRows value="100" />
              <Fields>
                <Field name="Subscription Date" />
                <Field name="Cancelation Date" />
              </Fields>
              <Data>
                <r>
                  <c>2020-01-29</c>
                  <c>2020-10-16</c>
                </r>
                <r>
                  <c>2020-01-07</c>
                  <c>2020-03-09</c>
                </r>
                <r>
                  <c>2020-01-01</c>
                  <c>2020-08-26</c>
                </r>
                <r>
                  <c>2020-01-03</c>
                  <c>2020-06-30</c>
