{
    "name": "rm2z/greenstep-backend",
    "description": "GreenStep - Personal Carbon Footprint & Eco Lifestyle Tracker. PHP Slim 4 RESTful API (PDO + MySQL + JWT).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "ignore": ["firebase/php-jwt"]
            }
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public"
    }
}
