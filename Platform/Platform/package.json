{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "description": "المنصة الشخصية — المرحلة 0 + 1 (الأساس + منصة الفصول)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "vite",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "tsc -p tsconfig.web.json --noEmit && vite build && node scripts/inline-html.mjs && node scripts/copy-pdfjs.mjs && node scripts/precompress.mjs",
    "build": "npm run build:server && npm run build:web && node scripts/ensure-build.mjs --stamp",
    "start": "node server",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "browser-smoke": "node scripts/browser-smoke.mjs",
    "ai:eval": "node scripts/ai-eval.mjs"
  },
  "dependencies": {
    "compression": "1.8.2",
    "express": "5.3.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "react-icons": "^5.7.0",
    "three": "0.184.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.184.0",
    "@vitejs/plugin-react": "6.1.2",
    "jszip": "3.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
