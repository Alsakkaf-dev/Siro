{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build && node scripts/vercel-static.mjs",
  "outputDirectory": "vercel-static",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{dist/**,seed/**,exchange/**,package.json}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
